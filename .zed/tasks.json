[
  {
    "label": "build",
    "command": "go build .",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "install",
    "command": "go install .",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "test",
    "command": "go test ./...",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "test:coverage",
    "command": "go test ./... -coverprofile=coverage.out; go tool cover -html=coverage.out",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "test:coverage:summary",
    "command": "go test ./... -coverprofile=coverage.out; go tool cover -func=coverage.out",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "licenses",
    "command": "go run github.com/google/go-licenses@v1.0.0 save ./... --save_path=THIRD_PARTY_NOTICES",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
